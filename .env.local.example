# ==============================================================================
# EvidenceLens - Environment Configuration Template
# Copy this file to `.env.local` for local development.
# ==============================================================================

# Multimodal AI Service (Google Gemini / Vertex AI)
# Required for Phase 2: Claim extraction, visual forensic reasoning, verdict synthesis
GEMINI_API_KEY=

# Evidence Search & Retrieval Services (Phase 2+)
# E.g. Tavily, Serper, or Custom Web Retrieval API
TAVILY_API_KEY=
SERPER_API_KEY=

# Reverse Image / Media Search Providers (Phase 2+)
GOOGLE_FACTCHECK_API_KEY=

# Application URL (for deployment verification)
NEXT_PUBLIC_APP_URL=http://localhost:3000
